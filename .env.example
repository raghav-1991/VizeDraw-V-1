# Copy to .env.local (or set in your hosting provider) and fill in approved values.
# Unset destinations fall back to an explanatory dialog; nothing is invented.
VITE_APP_SIGNUP_URL=https://app.vizedraw.com/signup
VITE_APP_SIGNIN_URL=https://app.vizedraw.com/
VITE_CHECKOUT_FREE_URL=https://app.vizedraw.com/settings/billing?plan=free&audience=individual
VITE_CHECKOUT_CONTROL_URL=https://app.vizedraw.com/settings/billing?plan=starter&audience=individual
VITE_CHECKOUT_PRO_URL=https://app.vizedraw.com/settings/billing?plan=pro&audience=individual
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_COOKIE_PREFERENCES_URL=
# Receives contact enquiries as JSON via POST. Without it, production builds
# show the submission error; `npm run dev` simulates success locally.
VITE_CONTACT_ENDPOINT=
